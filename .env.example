APP_NAME="Sharifi Academy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sharifi_academy
DB_USERNAME=root
DB_PASSWORD=secret
# With docker-compose: user sharifi / password secret, or root / secret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
# مدت سشن (دقیقه) — ۸۶۴۰۰ ≈ ۶۰ روز (۲ ماه) بدون فعالیت
SESSION_LIFETIME=86400
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# برای توسعه محلی سریع‌تر: file (به‌جای database که هر بار به MySQL می‌زند)
CACHE_STORE=file

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# استوری — حداکثر حجم ویدیو (مگابایت)
STORY_MAX_VIDEO_MB=5

MAIL_MAILER=log
